# Copiá este archivo como .env.local y completá los valores.
# .env.local está en .gitignore: nunca subas las claves reales al repo.
#
# Los dos valores salen del dashboard de Supabase:
#   Settings -> API -> Project URL / API Keys
#
# Ojo: es la publishable key (nomenclatura nueva), NO la anon key vieja
# ni la service_role, que nunca va en el front.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
